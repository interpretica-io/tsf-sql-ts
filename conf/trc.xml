              </results>
            </iter>
            <iter result="FAILED">
              <arg name="backend">sqlite</arg>
              <arg name="property">referential</arg>
              <notes>Control: the property is broken on purpose.</notes>
              <results>
                <result value="FAILED">
                  <verdict>t_av_child (parent_id) refers to rows missing from t_av</verdict>
                </result>
              </results>
            </iter>
            <iter result="FAILED">
              <arg name="backend">sqlite</arg>
              <arg name="property">not_null</arg>
              <notes>Control: the property is broken on purpose.</notes>
              <results>
                <result value="FAILED">
                  <verdict>NULL in (name) of t_av</verdict>
                </result>
              </results>
            </iter>
            <iter result="FAILED">
              <arg name="backend">sqlite</arg>
              <arg name="property">schema</arg>
              <notes>Control: the property is broken on purpose.</notes>
              <results>
                <result value="FAILED">
                  <verdict>schema of t_av is not compatible</verdict>
