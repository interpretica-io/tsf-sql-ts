<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Expected results. Every iteration not listed here is expected to pass
  (unknown_exp_status="passed_ok").

  The listed ones are the iterations of assert_violation: each breaks
  one property of a database on purpose and must FAIL with the verdict
  of the assertion that guards that property. They are the controls of
  the assertions - a run reports them as "failed, as expected". If an
  assertion stops noticing its violation the verdict changes and the
  run reports the iteration as unexpected.
-->
<trc_db unknown_exp_status="passed_ok">
