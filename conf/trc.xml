          <test name="assert_violation" type="script">
            <objective>Each database assertion fails, with its verdict, on a broken property.</objective>
            <notes />
            <iter result="FAILED">
              <arg name="backend">sqlite</arg>
              <arg name="property">row_count</arg>
              <notes>Control: the property is broken on purpose.</notes>
              <results>
                <result value="FAILED">
                  <verdict>unexpected number of rows in t_av</verdict>
                </result>
              </results>
            </iter>
            <iter result="FAILED">
              <arg name="backend">sqlite</arg>
              <arg name="property">pk_unique</arg>
              <notes>Control: the property is broken on purpose.</notes>
              <results>
                <result value="FAILED">
                  <verdict>key (id) of t_av is not unique</verdict>
